{{!
    @template core/user_action_menu_item_link

    Template for user action menu link

    Example context (json):
    {
        "title": "Github user",
        "url": "https://raw.githubusercontent.com/",
        "pixicon": [{
            "key": "t/dashboard",
            "component": "moodle",
            "title": "The dashboard icon"
        }],
        "classes": [
            "fw-bold",
            "fst-italic"
        ],
        "attributes": [{
            "name": "data-custom-attribute",
            "value": "1"
        }],
        "menuclasses": [
            "my-smartmenu-item"
        ],
        "tooltip": "This is a smart menu item",
        "text": "<b>Formatted</b> item text"
    }
}}
{{!
    This template is a modified version of core/user_action_menu_item_link

    Modifications compared to the original template:
    * Add menu classes to items.
    * Add tooltip to items.
    * Allow formatted text within the item.
}}
<a href="{{{url}}}" class="dropdown-item {{#classes}}{{.}} {{/classes}}{{#menuclasses}}{{.}} {{/menuclasses}}" {{#attributes}}{{name}}="{{value}}" {{/attributes}} {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip" {{/tooltip}}role="menuitem" tabindex="-1">
    {{#pixicon}}
        {{#pix}}{{key}}, {{component}}, {{title}}{{/pix}}
    {{/pixicon}}
    {{^pixicon}}
        {{#imgsrc}}<img class="icon" aria-hidden="true" src="{{imgsrc}}" alt="{{title}}"/>{{/imgsrc}}
    {{/pixicon}}
    {{#text}}{{{text}}}{{/text}}{{^text}}{{title}}{{/text}}
</a>
